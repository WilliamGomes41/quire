# Better Auth. Secret is required in production (32+ random chars: openssl rand -hex 32).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# One reader. Sign-up is closed; this owner is created on first start when no user exists yet.
# Changing these later does not change an existing account. Password: 12+ characters.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=

# Behind a trusted proxy: header(s) carrying the client IP, for sign-in rate limits (e.g. cf-connecting-ip).
AUTH_IP_HEADERS=

# Postgres / Neon. When unset, clips use PGLite (in memory: gone on restart).
DATABASE_URL=

# compose.yml only: password for its bundled Postgres (DATABASE_URL is set for you there).
# Use URL-safe characters, e.g. openssl rand -hex 24.
POSTGRES_PASSWORD=

# xAI grok-4.6 — Keep understanding, two related search strings, and optional take after Select. Missing key persists a fail; Keep still saves. Related-string or take failure does not fail Keep.
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Retrieval provider slot. Day-one dedicated search API. Missing key: unconfigured rail; Keep still saves.
SEARCH_PROVIDER=search_api
SEARCH_API_KEY=
SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
