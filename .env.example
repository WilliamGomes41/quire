# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Postgres / Neon. When unset, clips use PGLite.
DATABASE_URL=

# xAI grok-4.6 — Keep understanding and optional take after Select. Missing key persists a fail; Keep still saves. Take failure does not fail the issue.
XAI_API_KEY=
XAI_MODEL=grok-4.6

# Retrieval provider slot. Day-one dedicated search API. Missing key: unconfigured rail; Keep still saves.
SEARCH_PROVIDER=search_api
SEARCH_API_KEY=
SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
